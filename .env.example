# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env && chmod 600 .env

# Obrigatório — token do Claude Agent SDK. Gere com:
#   node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Opcional — voz premium via ElevenLabs. Sem isso, cai automático para o Edge TTS (gratuito).
ELEVENLABS_API_KEY=

# Opcional — só se for configurar o conector do Gmail/Calendar/Drive (Google Cloud Console,
# tipo de app "Desktop"). Sem isso, o Jarvis funciona normalmente sem esses conectores.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Opcional — token de acesso para usar o Jarvis pelo celular na mesma rede (veja o README).
# Gere qualquer string aleatória, ex.: openssl rand -hex 16
JARVIS_LAN_TOKEN=

# Opcionais — só se quiser fugir dos padrões:
# PORT=3111
# JARVIS_MODEL=sonnet
# JARVIS_WORKSPACE=/caminho/para/a/pasta/que-o-agente-pode-usar
